<Window x:Class="CalculatorWPF_Artemov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор Артемов" 
        Height="383" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow" Background="#FF8C8C8C">
    <Grid Margin="10,0,10,1" UseLayoutRounding="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="58*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="50*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Button x:Name="but0" Content="0" HorizontalAlignment="Center" Height="43" Grid.Row="6" VerticalAlignment="Center" Width="165" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" Grid.ColumnSpan="2" FontSize="24" FontFamily="Times New Roman" Click="btnNumber_Click"/>
        <Button x:Name="butRavno" Content="=" Height="43" Margin="6,0,0,0" Grid.Row="6" VerticalAlignment="Center" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" Grid.Column="3" FontSize="24" FontFamily="Times New Roman" FontWeight="Bold" Click="btnEquals_Click"/>
        <Button x:Name="butStep" Content="^" Height="43" Margin="6,0,0,0" Grid.Row="5" VerticalAlignment="Center" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" Grid.Column="3" FontSize="24" FontFamily="Times New Roman" FontWeight="Bold" Click="btnOperation_Click"/>
        <Button x:Name="but9" Content="9" Height="43" Margin="4,0,2,0" Grid.Row="5" VerticalAlignment="Center" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" Grid.Column="2" FontSize="24" FontFamily="Times New Roman" Click="btnNumber_Click"/>
        <Button x:Name="but8" Content="8" Height="43" Margin="4,0,1,0" Grid.Row="5" VerticalAlignment="Center" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" Grid.Column="1" FontSize="24" FontFamily="Times New Roman" Click="btnNumber_Click"/>
        <Button x:Name="but7" Content="7" Height="43" Grid.Row="5" VerticalAlignment="Center" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" FontSize="24" FontFamily="Times New Roman" Click="btnNumber_Click"/>
        <Button x:Name="butPlus" Content="+" Height="43" Margin="6,0,0,0" Grid.Row="4" VerticalAlignment="Center" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" Grid.Column="3" FontSize="24" FontFamily="Times New Roman" FontWeight="Bold" Click="btnOperation_Click"/>
        <Button x:Name="but6" Content="6" Height="43" Margin="4,0,2,0" Grid.Row="4" VerticalAlignment="Center" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" Grid.Column="2" FontSize="24" FontFamily="Times New Roman" Click="btnNumber_Click"/>
        <Button x:Name="but5" Content="5" Height="43" Margin="4,0,1,0" Grid.Row="4" VerticalAlignment="Center" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" Grid.Column="1" FontSize="24" FontFamily="Times New Roman" Click="btnNumber_Click"/>
        <Button x:Name="but4" Content="4" Height="43" Grid.Row="4" VerticalAlignment="Center" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" FontSize="24" FontFamily="Times New Roman" Click="btnNumber_Click"/>
        <Button x:Name="butMinus" Content="-" Height="43" Margin="6,0,0,0" Grid.Row="3" VerticalAlignment="Center" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" Grid.Column="3" FontSize="24" FontFamily="Times New Roman" FontWeight="Bold" Click="btnOperation_Click"/>
        <Button x:Name="but3" Content="3" Height="43" Margin="4,0,2,0" Grid.Row="3" VerticalAlignment="Center" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" Grid.Column="2" FontSize="24" FontFamily="Times New Roman" Click="btnNumber_Click"/>
        <Button x:Name="but2" Content="2" Height="43" Margin="4,0,1,0" Grid.Row="3" VerticalAlignment="Center" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" Grid.Column="1" FontSize="24" FontFamily="Times New Roman" Click="btnNumber_Click"/>
        <Button x:Name="but1" Content="1" Height="43" Grid.Row="3" VerticalAlignment="Center" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" FontSize="24" FontFamily="Times New Roman" Click="btnNumber_Click"/>
        <Button x:Name="butTochka" Content="." Height="43" Margin="4,0,2,0" Grid.Row="6" VerticalAlignment="Center" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" Grid.Column="2" FontSize="24" FontFamily="Times New Roman" FontWeight="Bold" Click="btnTochka_Click"/>
        <TextBox x:Name="display" Grid.ColumnSpan="4" Margin="1,10,1,1" TextAlignment="Right" TextWrapping="Wrap" BorderThickness="3,3,3,3" BorderBrush="#FF707070" FontSize="36" FontFamily="Times New Roman"/>
        <Label Content="Калькулятор" Grid.ColumnSpan="2" Margin="44,-25,9,41" FontSize="16" FontFamily="Times New Roman" FontWeight="Bold" Grid.Column="1"/>
        <Button x:Name="butUmnoz" Content="*" Height="43" Margin="6,8,0,0" Grid.Row="2" VerticalAlignment="Top" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" Grid.Column="3" FontSize="24" FontFamily="Times New Roman" FontWeight="Bold" Click="btnOperation_Click"/>
        <Button x:Name="butDel" Content="/" Height="43" Margin="4,8,2,0" Grid.Row="2" VerticalAlignment="Top" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" Grid.Column="2" FontSize="24" FontFamily="Times New Roman" FontWeight="Bold" Click="btnOperation_Click"/>
        <Button x:Name="butBackspase" Content="⌫" Height="43" Margin="4,11,0,0" Grid.Row="1" VerticalAlignment="Top" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" Grid.Column="2" FontSize="24" FontFamily="Times New Roman" Click="btnBackspace_Click" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
        <Button x:Name="butSbros" Content="C" Height="43" Grid.Row="1" VerticalAlignment="Top" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" FontSize="24" FontFamily="Times New Roman" BorderBrush="#FF707070" Click="btnSbros_Click" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="1,11,1,0"/>
        <Button x:Name="butSkoba2" Content=")" Height="43" Margin="4,9,1,0" Grid.Row="2" VerticalAlignment="Top" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" Grid.Column="1" FontSize="24" FontFamily="Times New Roman" Click="btnOperation_Click" Grid.RowSpan="2"/>
        <Button x:Name="butSkoba1" Content="(" Height="43" Grid.Row="2" VerticalAlignment="Top" BorderThickness="5,5,5,5" Panel.ZIndex="1" Padding="1,1,1,1" FontSize="24" FontFamily="Times New Roman" Click="btnOperation_Click" Margin="0,9,0,0" Grid.RowSpan="2"/>
    </Grid>
</Window>